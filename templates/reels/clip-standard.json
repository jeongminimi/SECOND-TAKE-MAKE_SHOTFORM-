    { "type": "box", "y": 186, "w": 900, "h": 3, "color": "accent" },
    { "type": "pill", "bind": "tag", "size": 40, "y": 230 },
    { "type": "text", "bind": "headline", "size": 72, "wrap": 24, "y": 360, "fadeIn": 0.2 },
    { "type": "clipCues", "bind": "clipCues", "size": 38, "y": 1180, "holdSec": 2.8 },
